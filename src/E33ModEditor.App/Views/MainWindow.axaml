<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:E33ModEditor.App.ViewModels"
        x:Class="E33ModEditor.App.Views.MainWindow"
        Title="Expedition 33 Editor"
        Icon="/Assets/app.ico"
        Width="1440" Height="860"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid x:Name="Stage" ClipToBounds="True">

            <!-- ═══ launcher (home + encounter hub) ═══ -->
            <DockPanel x:Name="LauncherPage">
                <DockPanel.RenderTransform>
                    <TranslateTransform />
                </DockPanel.RenderTransform>
                <Grid DockPanel.Dock="Top" Margin="28,22,28,8" ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Content="←  Home" Command="{Binding GoHomeCommand}"
                                IsVisible="{Binding IsHubOpen}"
                                VerticalAlignment="Center" />
                        <TextBlock Classes="title" FontSize="28" Text="Expedition 33" />
                        <TextBlock Text="EDITOR" FontFamily="{StaticResource SerifDisplay}" FontSize="12"
                                   Foreground="{StaticResource GoldDimBrush}" VerticalAlignment="Bottom"
                                   Margin="0,0,0,6" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LauncherTitle}" Classes="hint" VerticalAlignment="Center" />
                        <TextBlock Text="Language" Classes="hint" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <ComboBox ItemsSource="{Binding PackLanguages}"
                                  SelectedItem="{Binding SelectedPackLanguage, Mode=TwoWay}"
                                  MinWidth="130" VerticalAlignment="Center"
                                  ToolTip.Tip="{Binding PackLanguageHint}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Save project" Command="{Binding SaveProjectCommand}"
                                IsEnabled="{Binding CanPack}"
                                ToolTip.Tip="Save pending edits, pictos toggles and gameplay tweaks to a .project.json (work in parts, reload later)" />
                        <Button Content="Load project" Command="{Binding LoadProjectCommand}"
                                IsEnabled="{Binding CanPack}"
                                ToolTip.Tip="Load a .project.json, including the sidecar written next to Export/ExpeditionInfinity_seed_P" />
                        <TextBlock Text="Build: CLI rebuild-mod / standalone generator"
                                   Classes="hint" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border DockPanel.Dock="Bottom" Classes="panel" Padding="12,8" Margin="18,8,18,14">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" />
                </Border>

                <ItemsControl ItemsSource="{Binding VisibleTiles}" Margin="28,8,28,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" Rows="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModuleVM">
                            <Button Classes="tile"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Margin="14"
                                    Command="{Binding OpenCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding IsAvailable}">
                                <StackPanel Spacing="10" Margin="12">
                                    <TextBlock Text="{Binding Glyph}" FontSize="48"
                                               Foreground="{StaticResource GoldBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Classes="title" FontSize="26"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Tagline}" Classes="hint" FontSize="14"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               MaxWidth="360" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- ═══ module table ═══ -->
            <DockPanel x:Name="EditorPage" IsVisible="False">
                <DockPanel.RenderTransform>
                    <TranslateTransform />
                </DockPanel.RenderTransform>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="10,8,10,10">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="←  Back" Click="OnEditorBackClick" />
                        <TextBlock Classes="title" FontSize="21" Text="{Binding ActiveTitle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBox Grid.Column="2" x:Name="SearchBox" Watermark="Search records…" MinWidth="230"
                             VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ProgressBar Grid.Column="3" Height="4" Width="90" VerticalAlignment="Center" Margin="0,0,12,0"
                                 IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <TextBlock Grid.Column="4" Text="Builds: CLI rebuild-mod / standalone generator"
                               Classes="hint" VerticalAlignment="Center" />
                </Grid>

                <Border DockPanel.Dock="Bottom" Classes="panel" Padding="10,6" Margin="10,8,10,8">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" />
                </Border>

                <Grid>
                    <DataGrid x:Name="RecordGrid" Margin="10,0"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow}"
                              AutoGenerateColumns="False" CanUserResizeColumns="True"
                              CanUserSortColumns="True" Sorting="OnSorting"
                              GridLinesVisibility="Horizontal" IsReadOnly="False"
                              SelectionMode="Single" SelectionChanged="OnRowSelected"
                              LoadingRow="OnLoadingRow"
                              FontSize="13" />
                    <ContentControl x:Name="DirectHost" IsVisible="False" Margin="4,0,4,8"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </Grid>
            </DockPanel>

            <!-- ═══ full-window properties ═══ -->
            <DockPanel x:Name="DetailPage" IsVisible="False">
                <DockPanel.RenderTransform>
                    <TranslateTransform />
                </DockPanel.RenderTransform>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="10,8,10,4">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="←  Records" Click="OnDetailBackClick" />
                        <TextBlock x:Name="DetailTitle" Classes="title" FontSize="21" Text=""
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Builds: CLI rebuild-mod / standalone generator"
                               Classes="hint" VerticalAlignment="Center" />
                </Grid>
                <ContentControl x:Name="DetailHost" Margin="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </DockPanel>
        </Grid>

        <!-- ═══ first-launch loading overlay ═══ -->
        <Border IsVisible="{Binding IsLoading}" Background="#F2161411" ZIndex="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560" Spacing="8">
                <TextBlock Classes="title" FontSize="32" Text="Expedition 33" HorizontalAlignment="Center" />
                <TextBlock Text="EDITOR" FontFamily="{StaticResource SerifDisplay}" FontSize="13"
                           Foreground="{StaticResource GoldDimBrush}" HorizontalAlignment="Center"
                           Margin="0,0,0,16" />
                <ProgressBar Height="10" Minimum="0" Maximum="100"
                             Value="{Binding LoadProgress}" />
                <TextBlock Text="{Binding LoadMessage}" Classes="hint" FontSize="13"
                           HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- ═══ apply & pack progress overlay (modal) ═══ -->
        <Border IsVisible="{Binding IsPacking}" Background="#F2161411" ZIndex="30">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="720" Spacing="8">
                <TextBlock Classes="title" FontSize="24" Text="Applying &amp; Packing" HorizontalAlignment="Center" />
                <ProgressBar Height="10" IsIndeterminate="True" />
                <TextBlock Text="{Binding PackPhase}" Classes="hint" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                <Border Classes="panel" Padding="8" MaxHeight="320">
                    <ListBox x:Name="PackLogList" ItemsSource="{Binding PackLog}"
                             FontSize="11" Background="Transparent" />
                </Border>
                <TextBlock Text="Full log is appended to work/pack.log when the pack finishes."
                           Classes="hint" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
