<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AssemblyName>ExpeditionInfinity</AssemblyName>
    <RootNamespace>E33Packer.App</RootNamespace>
    <Version>1.3.5</Version>
    <AssemblyVersion>1.3.5.0</AssemblyVersion>
    <FileVersion>1.3.5.0</FileVersion>
    <InformationalVersion>1.3.5</InformationalVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <EmbeddedResource Include="Data/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\E33ModEditor.Core\E33ModEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.8" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.8" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.8" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tools\Mappings.usmap" CopyToOutputDirectory="PreserveNewest" Link="Mappings.usmap" Condition="Exists('..\..\tools\Mappings.usmap')" />
    <None Include="..\..\tools\MappingsLegacy.usmap" CopyToOutputDirectory="PreserveNewest" Link="MappingsLegacy.usmap" Condition="Exists('..\..\tools\MappingsLegacy.usmap')" />
    <!-- Bundled CUE4Parse Oodle runtime; never downloaded at runtime. -->
    <None Include="tools\liboodle-data-shared.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('tools\liboodle-data-shared.so')" />
    <None Include="tools\oodle-data-shared.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('tools\oodle-data-shared.dll')" />
  </ItemGroup>

  <!-- Local linux debug retoc; CI drops a release binary into tools/ instead. -->
  <ItemGroup Condition="Exists('tools/retoc') or Exists('tools/retoc.exe')">
    <None Include="tools/retoc" CopyToOutputDirectory="PreserveNewest" Condition="Exists('tools/retoc')" />
    <None Include="tools/retoc.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('tools/retoc.exe')" />
    <None Include="tools/*.so*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="tools/*.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('tools/retoc') and Exists('..\..\tools\retoc_cli-x86_64-unknown-linux-gnu\retoc')">
    <None Include="..\..\tools\retoc_cli-x86_64-unknown-linux-gnu\retoc" CopyToOutputDirectory="PreserveNewest" Link="retoc" />
    <None Include="..\..\tools\retoc_cli-x86_64-unknown-linux-gnu\liboo2corelinux64.so.9" CopyToOutputDirectory="PreserveNewest" Link="liboo2corelinux64.so.9" Condition="Exists('..\..\tools\retoc_cli-x86_64-unknown-linux-gnu\liboo2corelinux64.so.9')" />
  </ItemGroup>

  <!-- repak is required for localized packs (it packs the locres .pak stub). -->
  <ItemGroup Condition="Exists('..\..\tools\repak\repak') and '$(OS)' != 'Windows_NT'">
    <None Include="..\..\tools\repak\repak" CopyToOutputDirectory="PreserveNewest" Link="repak/repak" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\tools\repak\repak.exe') and '$(OS)' == 'Windows_NT'">
    <None Include="..\..\tools\repak\repak.exe" CopyToOutputDirectory="PreserveNewest" Link="repak/repak.exe" />
  </ItemGroup>
  <ItemGroup Condition="Exists('tools\repak\repak') and '$(OS)' != 'Windows_NT'">
    <None Include="tools\repak\repak" CopyToOutputDirectory="PreserveNewest" Link="repak/repak" />
  </ItemGroup>
  <ItemGroup Condition="Exists('tools\repak\repak.exe') and '$(OS)' == 'Windows_NT'">
    <None Include="tools\repak\repak.exe" CopyToOutputDirectory="PreserveNewest" Link="repak/repak.exe" />
  </ItemGroup>

</Project>
